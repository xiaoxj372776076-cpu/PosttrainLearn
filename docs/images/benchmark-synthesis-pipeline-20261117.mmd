flowchart TB
    subgraph MATERIAL["① 新材料准备"]
        A["上海公开判决原文<br/>不是完整诉讼卷宗"]
        B["整理为固定材料包<br/>保留段落ID、来源、事实与主张归属"]
        C["学生材料视图 v1.1<br/>保留必要事实，不含裁判结论与结果"]
        A --> B --> C
    end
    subgraph SEED["② 目标模型错题 → 完整示例"]
        D["PLawBench 原始题目与案情"]
        E["目标模型独立作答<br/>本轮实测4题，不提供答案或rubric"]
        F["对照原rubric、有据复核<br/>区分实质错误、标准问题、调用失败"]
        G["选出1道有据错题：case-068"]
        H["完整 One-Shot<br/>原案情＋原问题＋原rubric<br/>另附派生答案和纠错说明"]
        D --> E --> F --> G --> H
    end
    S["Skill 1.4.0<br/>模仿任务类型、提问方式与答案覆盖"]
    C --> P2
    H --> P2
    S --> P2
    subgraph GENERATE["③ 同类 QA 合成与验收"]
        P2["出题模型生成3个候选QA<br/>基于新材料，不复制种子事实"]
        P3["题面审核与选择<br/>检查可回答性、题型相似、答案暗示"]
        P4["独立新上下文建立参考答案与rubric<br/>核验事实定位、法条版本、替代答案"]
        P2 --> P3 --> P4
        P3 -. "盲答前题面修复" .-> P2
    end
    R["研究侧原文＋适用法条<br/>隐藏裁判理由仅供核验"]
    C --> P4
    R --> P4
    P4 --> LOCK["④ 冻结<br/>题目、学生材料、参考、评分门槛、模型配置<br/>保存哈希；盲答后不改题、不改标准"]
    subgraph TEST["⑤ 五答难度筛选"]
        STUDENT["目标模型5次独立盲答<br/>只接收冻结题目＋学生材料<br/>同配置、同服务模型身份"]
        JUDGE["逐答独立语义评分<br/>只看本答、题目、材料、冻结参考与法条<br/>不看few-shot、其他答卷或目标正确数"]
        STUDENT --> JUDGE
    end
    LOCK --> STUDENT
    LOCK -- "冻结参考与评分标准" --> JUDGE
    JUDGE --> RESULT["⑥ 本轮观测<br/>合同无效认定：1/5通过<br/>实际返还金额：5/5通过<br/>费用要求：0/5通过"]
    RESULT --> SAVE["整题测量未通过有效性门槛<br/>保留答卷、失败、原评分与复核建议<br/>不事后改分，不导出训练数据"]
    RESULT -. "仅首批有效且整题1–2/5通过时" .-> CONFIRM["原题再做新五答确认<br/>本轮未执行"]
